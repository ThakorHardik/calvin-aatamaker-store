# Supabase public browser config. These values are safe to expose when RLS is configured correctly.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Add payment secrets only to a server-only deployment environment when implementing Razorpay.
